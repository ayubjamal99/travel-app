# Copy to .env (post-create does this). .env is gitignored and agents are blocked from reading it.
# Running processes (Spring Boot, tests) can still read it, so app credentials go here too.

# Slack incoming webhook for the #agents channel (required for notifications)
SLACK_WEBHOOK_URL=

# Optional: label used in Slack messages
AGENTLOOP_NAME=travel-planner

# Watchdog poll interval in seconds (how often it checks GitHub for approvals/merges/replies)
AGENTLOOP_POLL_SECONDS=120

# --- App credentials: add here when an agent asks for them via Slack ---
# HELLO_GREETING=
